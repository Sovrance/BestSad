{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bestsad Assurance Certificate v0.1",
  "description": "Machine-verifiable statement of why a claim may be promoted (\u00a71.1). A certificate existing on disk never implies the claim is trusted (\u00a71.7): it is an input to the promotion predicate, not a substitute for it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate_id",
    "claim_id",
    "verifier",
    "status",
    "warrant"
  ],
  "properties": {
    "certificate_id": {
      "type": "string"
    },
    "claim_id": {
      "type": "string"
    },
    "verifier": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "warrant": {
      "enum": [
        "FORMAL",
        "RIGOROUS_COMPUTATION",
        "DIRECT_OBSERVATION",
        "CORROBORATED",
        "EMPIRICAL",
        "HEURISTIC",
        "ASSERTED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warrant_statement": {
      "type": "string"
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "issued_at": {
      "type": "string"
    }
  }
}
