{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bestsad Assumption Object v0.1",
  "description": "An environmental or semantic condition whose change invalidates descendants (\u00a71.6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assumption_id",
    "content_id",
    "scope",
    "status"
  ],
  "properties": {
    "assumption_id": {
      "type": "string"
    },
    "content_id": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "active_from": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "withdrawn"
      ]
    }
  }
}
