{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovrance.ai/sre/v0.1/artifact-ref.schema.json",
  "title": "SRE ArtifactRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "digest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mediaType": {
      "type": "string"
    },
    "uri": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}